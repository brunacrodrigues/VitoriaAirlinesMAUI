<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VitoriaAirlinesMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VitoriaAirlinesMAUI"
    xmlns:views="clr-namespace:VitoriaAirlinesMAUI.View"
    Shell.FlyoutBehavior="Disabled"
    Title="VitoriaAirlinesMAUI">

     <!-- Página de login (inicial) -->
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Página principal após login -->
    <ShellContent
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />


    <ShellContent
        ContentTemplate="{DataTemplate views:ForgotPasswordPage}"
        Route="ForgotPasswordPage"  />



</Shell>
