<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="VitoriaAirlinesMAUI.View.ProfilePage"
             Title="{Binding Title}"
             BackgroundColor="#0e0e0e"
             Loaded="OnPageLoaded">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

      
            <Frame BackgroundColor="#1a1a1a" 
                   CornerRadius="20" 
                   Padding="30,40" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                   
                    <Border StrokeShape="Ellipse"
                            Stroke="#D4A437"
                            StrokeThickness="3"
                            WidthRequest="120"
                            HeightRequest="120"
                            HorizontalOptions="Center"
                            BackgroundColor="#2a2a2a">
                        <Image Source="{Binding CurrentImageUrl}"
                               Aspect="AspectFill"/>
                    </Border>

             
                    <Button Text="Change Picture"
                            Command="{Binding SelectImageCommand}"
                            BackgroundColor="#D4A437"
                            TextColor="#0e0e0e"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48"
                            WidthRequest="200"
                            FontSize="15" />

          
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <CheckBox IsChecked="{Binding RemoveImage}"
                                  Color="#D4A437"/>
                        <Label Text="Remove profile picture"
                               FontSize="14"
                               TextColor="#888888"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

          
            <VerticalStackLayout Spacing="12">
                <Label Text="PERSONAL INFORMATION"
                       FontSize="12"
                       TextColor="#888888"
                       FontAttributes="Bold"
                       Margin="4,0,0,0"/>

                <Frame BackgroundColor="#1a1a1a" 
                       CornerRadius="16" 
                       Padding="20" 
                       HasShadow="True"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="16">

             
                        <VerticalStackLayout Spacing="8">
                            <Label Text="First Name"
                                   FontSize="12"
                                   TextColor="#888888"
                                   Margin="4,0"/>
                            <Border BackgroundColor="#2a2a2a"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16,0">
                                <Entry Text="{Binding FirstName}"
                                       Placeholder="Enter your first name"
                                       TextColor="White"
                                       PlaceholderColor="#666666"
                                       BackgroundColor="Transparent"
                                       HeightRequest="50"/>
                            </Border>
                        </VerticalStackLayout>

                
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Last Name"
                                   FontSize="12"
                                   TextColor="#888888"
                                   Margin="4,0"/>
                            <Border BackgroundColor="#2a2a2a"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16,0">
                                <Entry Text="{Binding LastName}"
                                       Placeholder="Enter your last name"
                                       TextColor="White"
                                       PlaceholderColor="#666666"
                                       BackgroundColor="Transparent"
                                       HeightRequest="50"/>
                            </Border>
                        </VerticalStackLayout>

                  
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nationality"
                                   FontSize="12"
                                   TextColor="#888888"
                                   Margin="4,0"/>
                            <Border BackgroundColor="#2a2a2a"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="0">
                                <syncfusion:SfComboBox ItemsSource="{Binding Countries}"
                                                       SelectedItem="{Binding SelectedCountry}"
                                                       DisplayMemberPath="Name"
                                                       Placeholder="Select your nationality"
                                                       TextColor="White"
                                                       BackgroundColor="Transparent"
                                                       HeightRequest="50"
                                                       Margin="16,0">
                                    <syncfusion:SfComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border StrokeShape="RoundRectangle 4"
                                                        BackgroundColor="#1a1a1a"
                                                        Padding="0"
                                                        WidthRequest="32"
                                                        HeightRequest="22">
                                                    <Image Source="{Binding FlagImageUrl}"
                                                           Aspect="AspectFill"/>
                                                </Border>

                                                <Label Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       TextColor="White"
                                                       VerticalOptions="Center"
                                                       FontSize="14"/>
                                            </Grid>
                                        </DataTemplate>
                                    </syncfusion:SfComboBox.ItemTemplate>
                                </syncfusion:SfComboBox>
                            </Border>
                        </VerticalStackLayout>

                 
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Passport Number"
                                   FontSize="12"
                                   TextColor="#888888"
                                   Margin="4,0"/>
                            <Border BackgroundColor="#2a2a2a"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16,0">
                                <Entry Text="{Binding PassportNumber}"
                                       Placeholder="Enter passport number"
                                       TextColor="White"
                                       PlaceholderColor="#666666"
                                       BackgroundColor="Transparent"
                                       HeightRequest="50"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        
            <Border BackgroundColor="#DC3545"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    IsVisible="{Binding HasError}"
                    Margin="0,4">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="White"
                       FontSize="13"
                       HorizontalTextAlignment="Center"/>
            </Border>

         
            <VerticalStackLayout Spacing="12" Margin="0,8,0,0">

              
                <Button Text="Save Changes"
                        Command="{Binding UpdateProfileCommand}"
                        BackgroundColor="#D4A437"
                        TextColor="#0e0e0e"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="54"
                        FontSize="16"
                        IsEnabled="{Binding IsNotBusy}">                  
                </Button>

              
                <Button Text="Logout"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="#4B0012"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="54"
                        FontSize="16"/>
            </VerticalStackLayout>

          
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#D4A437"
                               HeightRequest="40"
                               WidthRequest="40"
                               HorizontalOptions="Center"
                               Margin="0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>