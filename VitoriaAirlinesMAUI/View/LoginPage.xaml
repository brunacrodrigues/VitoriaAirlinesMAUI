<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
             x:Class="VitoriaAirlinesMAUI.View.LoginPage"
             x:DataType="viewmodel:LoginViewModel"
             BackgroundColor="#0e0e0e"
             Shell.NavBarIsVisible="False">

  
    <ContentPage.Resources>
        <Color x:Key="AccentColor">#D4A437</Color>
        <Color x:Key="CardBackground">#1a1a1a</Color>
        <Color x:Key="InputBackground">#2a2a2a</Color>
        <Color x:Key="PrimaryTextColor">White</Color>
        <Color x:Key="SubtitleTextColor">#cccccc</Color>
        <Color x:Key="ErrorColor">#850d1c</Color>
        <Color x:Key="LoginButtonColor">#4B0012</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto,*">

        <ScrollView Grid.Row="1" VerticalOptions="Center">

     
            <VerticalStackLayout Padding="30" HorizontalOptions="Center" MaximumWidthRequest="400">

           
                <Border BackgroundColor="{StaticResource CardBackground}"
                        StrokeShape="RoundRectangle 16"
                        Padding="25"
                        Stroke="#2a2a2a"
                        StrokeThickness="1"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">

                    <VerticalStackLayout Spacing="20">

                   
                        <Image Source="logo_va.png" 
                               WidthRequest="125" 
                               HeightRequest="50" 
                               HorizontalOptions="Center"
                               Margin="0,0,10,5"/>

            
                        <Label Text="Welcome back to your Vitoria Airlines account"
                               FontSize="15"
                               TextColor="{StaticResource AccentColor}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,10"/>

                      
                        <Border Padding="10,0"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource InputBackground}"
                                StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding Email}"
                                   Placeholder="Email"
                                   TextColor="{StaticResource PrimaryTextColor}"
                                   PlaceholderColor="#888"
                                   BackgroundColor="Transparent"
                                   HeightRequest="50" />
                        </Border>

                      
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="10,0"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource InputBackground}"
                                    StrokeShape="RoundRectangle 8">
                                <Entry Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       Placeholder="Password"
                                       TextColor="{StaticResource PrimaryTextColor}"
                                       PlaceholderColor="#888"
                                       BackgroundColor="Transparent"
                                       HeightRequest="50"
                                       x:Name="PasswordEntry" />
                            </Border>

                            <ImageButton Source="{Binding PasswordToggleIcon}"
                                         Command="{Binding TogglePasswordVisibilityCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="20"
                                         HeightRequest="20"
                                         HorizontalOptions="End"
                                         VerticalOptions="Center"
                                         Margin="0,0,10,0" />
                        </Grid>

                  
                        <Label Text="Forgot Password?"
                               TextColor="{StaticResource AccentColor}"
                               FontSize="13"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0,-8,2,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToForgotPasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                     
                        <HorizontalStackLayout HorizontalOptions="Start" Spacing="5" Margin="0,-10,0,0">
                            <CheckBox IsChecked="{Binding RememberMe}" Color="{StaticResource AccentColor}"/>
                            <Label Text="Remember Me"
                                   TextColor="{StaticResource PrimaryTextColor}"
                                   VerticalOptions="Center"
                                   FontSize="14"/>
                        </HorizontalStackLayout>

                      
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource PrimaryTextColor}"
                               BackgroundColor="{StaticResource ErrorColor}"
                               IsVisible="{Binding HasError}"
                               Padding="10"
                               FontSize="12"
                               HorizontalOptions="Fill"
                               HorizontalTextAlignment="Center"
                               Margin="0,-5,0,0"/>

                        <Button Text="Log In"
                                Command="{Binding LoginCommand}"
                                BackgroundColor="{StaticResource LoginButtonColor}"
                                TextColor="{StaticResource PrimaryTextColor}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="52"
                                FontSize="16"
                                IsEnabled="{Binding IsNotBusy}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource AccentColor}"
                                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
