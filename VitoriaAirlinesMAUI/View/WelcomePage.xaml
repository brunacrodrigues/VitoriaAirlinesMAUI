<ContentPage
    x:Class="VitoriaAirlinesMAUI.View.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
    x:DataType="viewmodel:WelcomeViewModel"
    Title="{Binding Title}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="DarkBackground">#0e0e0e</Color>
        <Color x:Key="CardBackground">#1a1a1a</Color>
        <Color x:Key="AccentColor">#D4A437</Color>
        <Color x:Key="GuestButtonColor">#4B0012</Color>
        <Color x:Key="PrimaryTextColor">White</Color>
        <Color x:Key="SubtitleTextColor">#888888</Color>
        <Color x:Key="DividerColor">#333333</Color>


        <Style TargetType="Button" x:Key="BaseButton">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>

        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
            <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
        </Style>

        <Style TargetType="Button" x:Key="GuestButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="BackgroundColor" Value="{StaticResource GuestButtonColor}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style TargetType="Button" x:Key="OutlineButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource AccentColor}" />
        </Style>

        <Style TargetType="Label" x:Key="HeaderLabel">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>

        <Style TargetType="Label" x:Key="TaglineLabel">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource SubtitleTextColor}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaximumWidthRequest" Value="300" />
        </Style>

        <Style TargetType="Label" x:Key="CardSubtitleLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource SubtitleTextColor}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style TargetType="Label" x:Key="FooterLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#555555" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin" Value="0,30,0,0" />
        </Style>

    </ContentPage.Resources>


    <ContentPage.BackgroundColor>
        <StaticResource Key="DarkBackground" />
    </ContentPage.BackgroundColor>

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,40,30,40"
            VerticalOptions="Center"
            MaximumWidthRequest="450">

            <VerticalStackLayout Spacing="5" Margin="0,0,0,5">
               
                <Image Source="logo_va.png" 
                       WidthRequest="200" 
                       HeightRequest="100" 
                       HorizontalOptions="Center"
                       Margin="0,0,30,0"/>

              
                <Label Style="{StaticResource TaglineLabel}"
                       Text="Fly with the best luxury experience"/>
            </VerticalStackLayout>

           
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20,16"
                    Stroke="#2a2a2a"
                    StrokeThickness="1"
                    Margin="0,10,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource HeaderLabel}"
                           Text="Start Your Journey"/>
                    <Label Style="{StaticResource CardSubtitleLabel}"
                           Text="Browse and book flights without creating an account"/>

                    
                    <Button Style="{StaticResource GuestButton}"
                            Text="Continue as Guest"
                            Command="{Binding GoToSearchCommand}"/>
                </VerticalStackLayout>
            </Border>

         
            <Grid ColumnDefinitions="*, Auto, *" 
                  ColumnSpacing="15"
                  Margin="0,20,0,20">
                <BoxView Grid.Column="0" 
                         HeightRequest="1" 
                         Color="{StaticResource DividerColor}"
                         VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="OR"
                       FontSize="13"
                       TextColor="#666666"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <BoxView Grid.Column="2" 
                         HeightRequest="1" 
                         Color="{StaticResource DividerColor}"
                         VerticalOptions="Center"/>
            </Grid>

      
            <VerticalStackLayout Spacing="12">
                <Label Text="Already a member?"
                       FontSize="15"
                       TextColor="#cccccc"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8"/>

      
                <Button Style="{StaticResource AccentButton}"
                        Text="Log In"
                        Command="{Binding GoToLoginCommand}"/>

         
                <Border Stroke="{StaticResource AccentColor}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="52">
                    <Button Style="{StaticResource OutlineButton}"
                            Text="Sign Up"
                            Command="{Binding GoToRegisterCommand}"/>
                </Border>
            </VerticalStackLayout>

            <Label Style="{StaticResource FooterLabel}"
                   Text="Your trusted travel partner since 2024"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>