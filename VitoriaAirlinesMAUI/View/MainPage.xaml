<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
             xmlns:converters="clr-namespace:VitoriaAirlinesMAUI.Converters"
             x:Class="VitoriaAirlinesMAUI.View.MainPage"
             x:DataType="viewmodel:MainPageViewModel"
             BackgroundColor="#0e0e0e"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:CountryCodeToFlagUrlConverter x:Key="CountryCodeToFlagUrlConverter" />

        <!-- Estilos Modernos -->
        <Style x:Key="StatCardStyle" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="#1a1a1a"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="BorderColor" Value="Transparent"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="#888888"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                             IsVisible="{Binding IsBusy}" 
                             Color="#D4A437"
                             HeightRequest="40"
                             WidthRequest="40"/>

            <!-- HEADER: Saudação e Avatar -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,5">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                    <Label Text="Welcome back," 
                           FontSize="15" 
                           TextColor="#888888"/>
                    <Label Text="{Binding FirstName}" 
                           FontSize="32" 
                           TextColor="#D4A437" 
                           FontAttributes="Bold"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        Stroke="#D4A437"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="#1a1a1a"
                        WidthRequest="56"
                        HeightRequest="56">
                    <Image Source="{Binding ProfilePictureUrl}" 
                           Aspect="AspectFill"/>
                </Border>
            </Grid>

            <!-- CARD PRÓXIMO VOO -->
            <Border Stroke="#D4A437"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#4B0012"
                    Padding="0"
                    HorizontalOptions="Fill"
                    MinimumHeightRequest="240">

                <!-- Header do Card -->
                <Grid RowDefinitions="Auto, *" RowSpacing="0">
                    <Grid Grid.Row="0" 
                          Padding="20,20,20,18"
                          ColumnDefinitions="*">
                        <Label Grid.Column="0"
                               Text="Your Next Flight" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Conteúdo do Voo -->
                    <VerticalStackLayout Grid.Row="1" 
                                       Padding="20,5,20,25"
                                       Spacing="15"
                                       IsVisible="{Binding HasNextFlight}">

                        <!-- Rota: Origem -> Destino -->
                        <Grid ColumnDefinitions="Auto, 60, Auto, 60, Auto" 
                              ColumnSpacing="0"
                              Margin="0,5,0,10">

                            <!-- Origem -->
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        BackgroundColor="#3a0010"
                                        Padding="3"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        HorizontalOptions="Center">
                                    <Image VerticalOptions="Center" HorizontalOptions="Center"
                                           Source="{Binding NextFlight.OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}" />
                                </Border>
                                <Label Text="{Binding NextFlight.OriginIATA}" 
                                       FontSize="34" 
                                       FontAttributes="Bold" 
                                       TextColor="White" 
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- Linha conectora -->
                            <BoxView Grid.Column="1"
                                     Color="#D4A437"
                                     HeightRequest="2"
                                     VerticalOptions="Center"
                                     Margin="10,0"/>

                            <!-- Ícone Avião -->
                            <Label Grid.Column="2"
                                   Text="✈"
                                   FontSize="24"
                                   TextColor="#D4A437"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>

                            <!-- Linha conectora -->
                            <BoxView Grid.Column="3"
                                     Color="#D4A437"
                                     HeightRequest="2"
                                     VerticalOptions="Center"
                                     Margin="10,0"/>

                            <!-- Destino -->
                            <VerticalStackLayout Grid.Column="4" Spacing="8">
                                <Border StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        BackgroundColor="#3a0010"
                                        Padding="3"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        HorizontalOptions="Center">
                                    <Image VerticalOptions="Center" HorizontalOptions="Center"
                                           Source="{Binding NextFlight.DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}" />
                                </Border>
                                <Label Text="{Binding NextFlight.DestinationIATA}" 
                                       FontSize="34" 
                                       FontAttributes="Bold" 
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1" 
                                 BackgroundColor="#3a0010"
                                 Margin="0,5,0,10"/>

                        <!-- Detalhes do Voo -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding NextFlight.OriginAirportFullName}" 
                                   FontSize="13" 
                                   TextColor="#e0e0e0"
                                   LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding NextFlight.DestinationAirportFullName}" 
                                   FontSize="13" 
                                   TextColor="#e0e0e0"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Info Highlight -->
                            <Border BackgroundColor="#3a0010"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="14,12"
                                    Margin="0,5,0,0">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Departure" 
                                               FontSize="11" 
                                               TextColor="#D4A437"/>
                                        <Label Text="{Binding NextFlight.DepartureTime, StringFormat='{0:MMM dd, HH:mm}'}" 
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Flight" 
                                               FontSize="11" 
                                               TextColor="#888888"
                                               HorizontalOptions="End"/>
                                        <Label Text="{Binding NextFlight.FlightNumber}" 
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#cccccc"
                                               HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Mensagem Vazia -->
                    <VerticalStackLayout Grid.Row="1"
                                       Padding="20,10,20,30"
                                       Spacing="12"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding HasNoNextFlight}">
                        <Label Text="No upcoming flights" 
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="Ready to explore the world?" 
                               FontSize="14"
                               TextColor="#cccccc"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ESTATÍSTICAS -->
            <Grid ColumnDefinitions="*,*" 
                  RowDefinitions="Auto, Auto" 
                  RowSpacing="12" 
                  ColumnSpacing="12"
                  Margin="0,5,0,0">

                <!-- Upcoming Flights -->
                <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="📅" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Upcoming" Style="{StaticResource CardTitleStyle}"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding UpcomingFlightsCount}" 
                               Style="{StaticResource CardValueStyle}"
                               TextColor="#D4A437"/>
                        <Label Text="flights" 
                               FontSize="11" 
                               TextColor="#666666"
                               Margin="0,2,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Completed Flights -->
                <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="✓" FontSize="16" VerticalOptions="Center" TextColor="#4CAF50"/>
                            <Label Text="Completed" Style="{StaticResource CardTitleStyle}"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding CompletedFlightsCount}" 
                               Style="{StaticResource CardValueStyle}"
                               TextColor="White"/>
                        <Label Text="flights" 
                               FontSize="11" 
                               TextColor="#666666"
                               Margin="0,2,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Total Spent -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" 
                        BackgroundColor="#1a1a1a" 
                        StrokeShape="RoundRectangle 16" 
                        Stroke="#D4A437"
                        StrokeThickness="2"
                        Padding="20,18">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="💰" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="Total Spent" Style="{StaticResource CardTitleStyle}"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalSpent, StringFormat='€{0:N2}'}" 
                                   Style="{StaticResource CardValueStyle}"
                                   TextColor="#D4A437"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="→"
                               FontSize="32"
                               TextColor="#D4A437"
                               VerticalOptions="Center"
                               Opacity="0.5"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Botão -->
            <Button Text="Browse &amp; Book New Flights"
                    Command="{Binding GoToSearchCommand}"
                    BackgroundColor="#D4A437"
                    TextColor="#0e0e0e"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54"
                    Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>