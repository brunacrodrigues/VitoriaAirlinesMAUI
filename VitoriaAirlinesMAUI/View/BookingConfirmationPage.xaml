<ContentPage
    x:Class="VitoriaAirlinesMAUI.View.BookingConfirmationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
    xmlns:model="clr-namespace:VitoriaAirlinesMAUI.Model"
    x:DataType="viewmodel:BookingConfirmationViewModel"
    Title="{Binding Title}"
    BackgroundColor="#0e0e0e">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#D4A437"/>
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="Red" HorizontalOptions="Center"/>

            <!-- TRIP SUMMARY -->
            <Frame BackgroundColor="#1a1a1a" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Trip Summary" FontSize="22" FontAttributes="Bold" TextColor="White"/>

                    <!-- Outbound Flight -->
                    <Label Text="{Binding OutboundFlight.FlightNumber, StringFormat='Outbound Flight: {0}'}" TextColor="#D4A437"/>
                    <Label TextColor="#cccccc">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Seat: "/>
                                <Span Text="{Binding OutboundSeat.Row}"/>
                                <Span Text="{Binding OutboundSeat.Letter}"/>
                                <Span Text=" ("/>
                                <Span Text="{Binding OutboundFareClass}"/>
                                <Span Text=")"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Return Flight -->
                    <BoxView HeightRequest="1" Color="#333333" IsVisible="{Binding IsRoundTrip}"/>
                    <Label Text="{Binding ReturnFlight.FlightNumber, StringFormat='Return Flight: {0}'}" TextColor="#D4A437" IsVisible="{Binding IsRoundTrip}"/>
                    <Label TextColor="#cccccc" IsVisible="{Binding IsRoundTrip}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Seat: "/>
                                <Span Text="{Binding ReturnSeat.Row}"/>
                                <Span Text="{Binding ReturnSeat.Letter}"/>
                                <Span Text=" ("/>
                                <Span Text="{Binding ReturnFareClass}"/>
                                <Span Text=")"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Total -->
                    <BoxView HeightRequest="1" Color="#333333"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="TOTAL TO PAY" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" Text="{Binding TotalPrice, StringFormat='€{0:0.00}'}" FontSize="24" FontAttributes="Bold" TextColor="#D4A437"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- PASSENGER DETAILS -->
            <Label Text="Passenger Details" FontSize="22" FontAttributes="Bold" Margin="0,10,0,0" TextColor="White"/>

            <!-- AUTHENTICATED CUSTOMER: Read-only display -->
            <Frame BackgroundColor="#1a1a1a" CornerRadius="10" Padding="15" IsVisible="{Binding IsCustomerAuthenticated}">
                <VerticalStackLayout Spacing="10">
                    <!-- Profile Complete - Show info -->
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="10" 
                          IsVisible="{Binding IsProfileComplete}">
                        <Label Grid.Row="0" Grid.Column="0" Text="Name:" FontAttributes="Bold" TextColor="#cccccc"/>
                        <Label Grid.Row="0" Grid.Column="1" TextColor="White">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding FirstName}"/>
                                    <Span Text=" "/>
                                    <Span Text="{Binding LastName}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Grid.Row="1" Grid.Column="0" Text="Email:" FontAttributes="Bold" TextColor="#cccccc"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Email}" TextColor="White"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Passport:" FontAttributes="Bold" TextColor="#cccccc"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding PassportNumber}" TextColor="White"/>
                    </Grid>

                    <!-- Profile Incomplete - Show form -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsProfileIncomplete}">
                        <Label Text="Please complete your profile information:" 
                               TextColor="#D4A437" FontSize="14"/>

                      
                        <Entry Placeholder="Passport Number" Text="{Binding PassportNumber}" 
           PlaceholderColor="#cccccc" TextColor="White" BackgroundColor="#2a2a2a"
           IsReadOnly="{Binding IsPassportReadOnly}" />
                    
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- ANONYMOUS USER: Input fields for new account -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNotCustomerAuthenticated}">
                <Label Text="Create your account to complete booking (login details will be emailed to you):" 
                       TextColor="#D4A437" FontSize="14"/>

                <Entry Placeholder="First Name" Text="{Binding FirstName}" 
                       PlaceholderColor="#cccccc" TextColor="White" BackgroundColor="#2a2a2a"/>
                <Entry Placeholder="Last Name" Text="{Binding LastName}" 
                       PlaceholderColor="#cccccc" TextColor="White" BackgroundColor="#2a2a2a"/>
                <Entry Placeholder="Email (Your new login username)" Text="{Binding Email}" 
                       PlaceholderColor="#cccccc" TextColor="White" BackgroundColor="#2a2a2a"/>
                <Entry Placeholder="Passport Number" Text="{Binding PassportNumber}" 
                       PlaceholderColor="#cccccc" TextColor="White" BackgroundColor="#2a2a2a"/>
            </VerticalStackLayout>

            <!-- PAYMENT BUTTON -->
            <Button Text="{Binding TotalPrice, StringFormat='Proceed to Payment - €{0:0.00}'}"
                    Command="{Binding ProceedToPaymentCommand}"
                    BackgroundColor="#D4A437"
                    TextColor="#0e0e0e"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>