<ContentPage
    x:Class="VitoriaAirlinesMAUI.View.PaymentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
    x:DataType="viewmodel:PaymentViewModel"
    BackgroundColor="#0e0e0e"
    Title="Secure Payment">

    <Grid>
        <WebView x:Name="PaymentWebView"
                 Source="{Binding CheckoutUrl}"
                 Navigating="WebView_Navigating"/>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#D4A437"
                           VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>