<ContentPage
    x:Class="VitoriaAirlinesMAUI.View.FlightSearchResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
    xmlns:model="clr-namespace:VitoriaAirlinesMAUI.Model"
    xmlns:converters="clr-namespace:VitoriaAirlinesMAUI.Converters"
    x:DataType="viewmodel:FlightSearchResultsViewModel"
    BackgroundColor="#0e0e0e"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:CountryCodeToFlagUrlConverter x:Key="CountryCodeToFlagUrlConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">

            <!-- No flights message -->
            <VerticalStackLayout IsVisible="{Binding IsNoFlightsMessageVisible}">
                <Label Text="No flights found for your selected criteria."
                       TextColor="#cccccc"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="20" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasAnyFlights}">

                <!-- OUTBOUND -->
                <Label Text="Outbound Flights"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"
                       IsVisible="{Binding HasOutboundFlights}"/>

                <CollectionView ItemsSource="{Binding OutboundFlights}"
                                IsVisible="{Binding HasOutboundFlights}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:FlightSearchResult">
                            <Frame HasShadow="False"
                                   Padding="0"
                                   Margin="0,5,0,5"
                                   CornerRadius="8">
                                <Frame.Style>
                                    <Style TargetType="Frame">
                                        <!-- Default Frame styles -->
                                        <Setter Property="BackgroundColor" Value="#1a1a1a"/>
                                        <Setter Property="BorderColor" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- Trigger for when this item's IsSelected is true -->
                                            <DataTrigger TargetType="Frame"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="#331122"/>
                                                <Setter Property="BorderColor" Value="#D4A437"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Frame.Style>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="*, Auto, *, Auto" Padding="10">
                                        <!-- Departure -->
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding DepartureUtc, StringFormat='{0:HH:mm}'}"
                                                   FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24"
                                                       Source="{Binding OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsOriginCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding OriginAirportIATA}"
                                                       FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Arrow -->
                                        <Label Grid.Column="1" Text="→" FontSize="28" TextColor="White"
                                               VerticalOptions="Center" HorizontalOptions="Center"/>

                                        <!-- Arrival -->
                                        <VerticalStackLayout Grid.Column="2">
                                            <Label Text="{Binding ArrivalUtc, StringFormat='{0:HH:mm}'}"
                                                   FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24"
                                                       Source="{Binding DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsDestinationCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding DestinationAirportIATA}"
                                                       FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Price -->
                                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="End">
                                            <Label Text="{Binding EconomyClassPrice, StringFormat='€{0:0.00}'}"
                                                   FontSize="24" FontAttributes="Bold" TextColor="#D4A437"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Extra info -->
                                    <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="10" Padding="10,0">
                                        <Label Grid.Column="0" Text="{Binding Duration, StringFormat='• {0:h\\h\\ m\\m}'}"
                                               FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="1" Text="• Nonstop" FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="2" Text="{Binding FlightNumber, StringFormat='• Flight {0}'}"
                                               FontSize="14" TextColor="#cccccc"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*" Padding="10,10,10,10">
                                        <Label Text="Vitoria Airlines"
                                               FontSize="16" TextColor="#D4A437"/>
                                    </Grid>

                                    <!-- Button to select outbound flight -->
                                    <Button Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:FlightSearchResultsViewModel}}, Path=SelectOutboundFlightCommand}"
                                            CommandParameter="{Binding .}"
                                            Margin="10"
                                            BackgroundColor="#D4A437"
                                            TextColor="#0e0e0e"
                                            CornerRadius="8"
                                            FontAttributes="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Text" Value="Select Outbound Flight"/>
                                                <Style.Triggers>
                                                    <!-- Bind to IsSelected property of the current item -->
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="Selected"/>
                                                        <!-- Optional: Change background color for selected button state -->
                                                        <!-- <Setter Property="BackgroundColor" Value="#8BC34A"/> -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- One-Way Button -->
                <Button Text="Book Flight"
                        IsVisible="{Binding CanBookOneWayFlight}"
                        Command="{Binding BookFlightsCommand}"
                        Margin="0,20,0,0"
                        BackgroundColor="#4B0012"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"/>

                <!-- RETURN -->
                <Label Text="Return Flights"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,20,0,0"
                       IsVisible="{Binding HasReturnFlights}"/>

                <CollectionView ItemsSource="{Binding ReturnFlights}"
                                IsVisible="{Binding HasReturnFlights}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:FlightSearchResult">
                            <Frame HasShadow="False"
                                   Padding="0"
                                   Margin="0,5,0,5"
                                   CornerRadius="8">
                                <Frame.Style>
                                    <Style TargetType="Frame">
                                        <!-- Default Frame styles -->
                                        <Setter Property="BackgroundColor" Value="#1a1a1a"/>
                                        <Setter Property="BorderColor" Value="Transparent"/>
                                        <Style.Triggers>
                                            <!-- Trigger for when this item's IsSelected is true -->
                                            <DataTrigger TargetType="Frame"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="#331122"/>
                                                <Setter Property="BorderColor" Value="#D4A437"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Frame.Style>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="*, Auto, *, Auto" Padding="10">
                                        <!-- Departure -->
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding DepartureUtc, StringFormat='{0:HH:mm}'}"
                                                   FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24"
                                                       Source="{Binding OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsOriginCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding OriginAirportIATA}"
                                                       FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Arrow -->
                                        <Label Grid.Column="1" Text="→" FontSize="28" TextColor="White"
                                               VerticalOptions="Center" HorizontalOptions="Center"/>

                                        <!-- Arrival -->
                                        <VerticalStackLayout Grid.Column="2">
                                            <Label Text="{Binding ArrivalUtc, StringFormat='{0:HH:mm}'}"
                                                   FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24"
                                                       Source="{Binding DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsDestinationCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding DestinationAirportIATA}"
                                                       FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Price -->
                                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="End">
                                            <Label Text="{Binding EconomyClassPrice, StringFormat='€{0:0.00}'}"
                                                   FontSize="24" FontAttributes="Bold" TextColor="#D4A437"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Extra info -->
                                    <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="10" Padding="10,0">
                                        <Label Grid.Column="0" Text="{Binding Duration, StringFormat='• {0:h\\h\\ m\\m}'}"
                                               FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="1" Text="• Nonstop" FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="2" Text="{Binding FlightNumber, StringFormat='• Flight {0}'}"
                                               FontSize="14" TextColor="#cccccc"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*" Padding="10,10,10,10">
                                        <Label Text="Vitoria Airlines"
                                               FontSize="16" TextColor="#D4A437"/>
                                    </Grid>

                                    <!-- Button to select return flight -->
                                    <Button Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:FlightSearchResultsViewModel}}, Path=SelectReturnFlightCommand}"
                                            CommandParameter="{Binding .}"
                                            Margin="10"
                                            BackgroundColor="#D4A437"
                                            TextColor="#0e0e0e"
                                            CornerRadius="8"
                                            FontAttributes="Bold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Text" Value="Select Return Flight"/>
                                                <Style.Triggers>
                                                    <!-- Bind to IsSelected property of the current item -->
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="Selected"/>
                                                        <!-- Optional: Change background color for selected button state -->
                                                        <!-- <Setter Property="BackgroundColor" Value="#8BC34A"/> -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Round Trip Button -->
                <Button Text="Book Selected Flights"
                        IsVisible="{Binding CanBookRoundTripFlights}"
                        Command="{Binding BookFlightsCommand}"
                        Margin="0,20,0,0"
                        BackgroundColor="#4B0012"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>