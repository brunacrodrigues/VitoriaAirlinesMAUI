<ContentPage
    x:Class="VitoriaAirlinesMAUI.View.FlightSearchResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
    xmlns:model="clr-namespace:VitoriaAirlinesMAUI.Model"
    xmlns:converters="clr-namespace:VitoriaAirlinesMAUI.Converters"
    x:DataType="viewmodel:FlightSearchResultsViewModel"
    BackgroundColor="#0e0e0e"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <!-- Converters -->
        <converters:CountryCodeToFlagUrlConverter x:Key="CountryCodeToFlagUrlConverter" />

        <!-- Styles -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Frame">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BackgroundColor" Value="#1a1a1a"/>
           
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4B0012"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Label Text="Search Results" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>

            <!-- EmptyView-->
            <VerticalStackLayout IsVisible="{Binding IsNoFlightsMessageVisible}">
                <Label Text="No flights found for your selected criteria."
                       TextColor="#cccccc"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="20" />
            </VerticalStackLayout>

           
            <VerticalStackLayout IsVisible="{Binding HasAnyFlights}">
                <Label Text="Outbound Flights" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0"
                       IsVisible="{Binding HasOutboundFlights}"/>
                <CollectionView ItemsSource="{Binding OutboundFlights}" SelectionMode="None"
                                IsVisible="{Binding HasOutboundFlights}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:FlightSearchResult">
                            <Frame BorderColor="#A67C26">
                                <VerticalStackLayout Spacing="0">
                                    
                                    <Grid ColumnDefinitions="*, Auto, *, Auto" Padding="10">
                                        <!-- Departure Time & IATA -->
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Start">
                                            <Label Text="{Binding DepartureUtc, StringFormat='{0:HH:mm}'}" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24" Aspect="AspectFill"
                                                       Source="{Binding OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsOriginCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding OriginAirportIATA}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Arrow -->
                                        <Label Grid.Column="1" Text="→" FontSize="28" TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" Margin="5,0"/>

                                        <!-- Arrival Time & IATA -->
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Start">
                                            <Label Text="{Binding ArrivalUtc, StringFormat='{0:HH:mm}'}" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24" Aspect="AspectFill"
                                                       Source="{Binding DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsDestinationCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding DestinationAirportIATA}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Price -->
                                        <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="End" Margin="10,0,0,0">
                                            <Label Text="{Binding EconomyClassPrice, StringFormat='€{0:0.00}'}" FontSize="24" FontAttributes="Bold" TextColor="#D4A437"/>
                                           
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Duration, Nonstop, flightno) -->
                                    <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="10" Padding="10,0">
                                        <Label Grid.Column="0" Text="{Binding Duration, StringFormat='• {0:h\\h\\ m\\m}'}" FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="1" Text="• Nonstop" FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="2" Text="{Binding FlightNumber, StringFormat='• Flight {0}'}" FontSize="14" TextColor="#cccccc"/>
                                    </Grid>

                                    
                                    <Grid ColumnDefinitions="*, Auto" Padding="10,10,10,10">
                                        <Label Grid.Column="0" Text="Vitoria Airlines" FontSize="16" TextColor="#D4A437" VerticalOptions="Center" HorizontalOptions="Start"/>

                                        <Button Grid.Column="1" Text="Book" BackgroundColor="#4B0012" TextColor="White" CornerRadius="8"
                                                Padding="15,8" FontSize="16" HeightRequest="45" WidthRequest="100"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No specific outbound flights found." TextColor="#cccccc" HorizontalOptions="Center" Margin="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <Label Text="Return Flights" FontSize="18" FontAttributes="Bold" Margin="0,20,0,0"
                       IsVisible="{Binding HasReturnFlights}"/>
                <CollectionView ItemsSource="{Binding ReturnFlights}" SelectionMode="None"
                                IsVisible="{Binding HasReturnFlights}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:FlightSearchResult">
                            <Frame BorderColor="#4B0012">
                                <VerticalStackLayout Spacing="0">
                                 
                                    <Grid ColumnDefinitions="*, Auto, *, Auto" Padding="10">
                                        <!-- Departure Time & IATA -->
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Start">
                                            <Label Text="{Binding DepartureUtc, StringFormat='{0:HH:mm}'}" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24" Aspect="AspectFill"
                                                       Source="{Binding OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsOriginCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding OriginAirportIATA}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Arrow -->
                                        <Label Grid.Column="1" Text="→" FontSize="28" TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" Margin="5,0"/>

                                        <!-- Arrival Time & IATA -->
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Start">
                                            <Label Text="{Binding ArrivalUtc, StringFormat='{0:HH:mm}'}" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                                <Image Grid.Column="0" HeightRequest="16" WidthRequest="24" Aspect="AspectFill"
                                                       Source="{Binding DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                       IsVisible="{Binding IsDestinationCountryCodeVisible}"/>
                                                <Label Grid.Column="1" Text="{Binding DestinationAirportIATA}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <!-- Price -->
                                        <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="End" Margin="10,0,0,0">
                                            <Label Text="{Binding EconomyClassPrice, StringFormat='€{0:0.00}'}" FontSize="24" FontAttributes="Bold" TextColor="#D4A437"/>           
                                        </VerticalStackLayout>
                                    </Grid>

                                 
                                    <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="10" Padding="10,0">
                                        <Label Grid.Column="0" Text="{Binding Duration, StringFormat='• {0:h\\h\\ m\\m}'}" FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="1" Text="• Nonstop" FontSize="14" TextColor="#cccccc"/>
                                        <Label Grid.Column="2" Text="{Binding FlightNumber, StringFormat='• Flight {0}'}" FontSize="14" TextColor="#cccccc"/>
                                    </Grid>

                                  
                                    <Grid ColumnDefinitions="*, Auto" Padding="10,10,10,10">
                                        <Label Grid.Column="0" Text="Vitoria Airlines" FontSize="16" TextColor="#D4A437" VerticalOptions="Center" HorizontalOptions="Start"/>

                                        <Button Grid.Column="1" Text="Book" BackgroundColor="#4B0012" TextColor="White" CornerRadius="8"
                                                Padding="15,8" FontSize="16" HeightRequest="45" WidthRequest="100"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No specific return flights found." TextColor="#cccccc" HorizontalOptions="Center" Margin="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>