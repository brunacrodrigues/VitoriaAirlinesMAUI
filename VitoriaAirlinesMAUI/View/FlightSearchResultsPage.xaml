<ContentPage
    x:Class="VitoriaAirlinesMAUI.View.FlightSearchResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
    xmlns:model="clr-namespace:VitoriaAirlinesMAUI.Model"
    xmlns:converters="clr-namespace:VitoriaAirlinesMAUI.Converters"
    x:DataType="viewmodel:FlightSearchResultsViewModel"
    BackgroundColor="#0e0e0e"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:CountryCodeToFlagUrlConverter x:Key="CountryCodeToFlagUrlConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

     
            <VerticalStackLayout IsVisible="{Binding IsNoFlightsMessageVisible}" 
                                 Spacing="15" 
                                 VerticalOptions="Center"
                                 Padding="40">
                <Image Source="myflights_icon.png" 
WidthRequest="125" 
HeightRequest="50" 
HorizontalOptions="Center"
Margin="0,0,10,5"/>
                <Label Text="No flights found"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Try adjusting your search criteria"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasAnyFlights}" Spacing="24">

               
                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasOutboundFlights}">
                    <Label Text="OUTBOUND FLIGHTS"
                           FontSize="12"
                           TextColor="#888888"
                           FontAttributes="Bold"
                           Margin="4,0,0,0"/>

                    <CollectionView ItemsSource="{Binding OutboundFlights}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:FlightSearchResult">
                                <Frame HasShadow="True"
                                       Padding="0"
                                       Margin="0,0,0,12"
                                       CornerRadius="16"
                                       BackgroundColor="#1a1a1a"
                                       BorderColor="Transparent">
                                    <Frame.Style>
                                        <Style TargetType="Frame">
                                            <Setter Property="BorderColor" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Frame"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BorderColor" Value="#D4A437"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Frame.Style>

                                    <VerticalStackLayout Spacing="0">
                                
                                        <Grid ColumnDefinitions="*,Auto,*,Auto" 
                                              Padding="20,16"
                                              RowSpacing="8">

                                 
                                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="{Binding DepartureUtc, StringFormat='{0:HH:mm}'}"
                                                       FontSize="24" 
                                                       FontAttributes="Bold" 
                                                       TextColor="White"/>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="#2a2a2a"
                                                            Padding="0"
                                                            WidthRequest="28"
                                                            HeightRequest="20"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding IsOriginCountryCodeVisible}">
                                                        <Image Source="{Binding OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                               Aspect="AspectFill"/>
                                                    </Border>
                                                    <Label Text="{Binding OriginAirportIATA}"
                                                           FontSize="20" 
                                                           FontAttributes="Bold" 
                                                           TextColor="White"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                       
                                            <Label Grid.Column="1" 
                                                   Text="→" 
                                                   FontSize="32" 
                                                   TextColor="#D4A437"
                                                   VerticalOptions="Center" 
                                                   HorizontalOptions="Center"
                                                   Margin="10,0"/>

                                          
                                            <VerticalStackLayout Grid.Column="2" Spacing="6">
                                                <Label Text="{Binding ArrivalUtc, StringFormat='{0:HH:mm}'}"
                                                       FontSize="24" 
                                                       FontAttributes="Bold" 
                                                       TextColor="White"/>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="#2a2a2a"
                                                            Padding="0"
                                                            WidthRequest="28"
                                                            HeightRequest="20"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding IsDestinationCountryCodeVisible}">
                                                        <Image Source="{Binding DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                               Aspect="AspectFill"/>
                                                    </Border>
                                                    <Label Text="{Binding DestinationAirportIATA}"
                                                           FontSize="20" 
                                                           FontAttributes="Bold" 
                                                           TextColor="White"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                      
                                            <VerticalStackLayout Grid.Column="3" 
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding EconomyClassPrice, StringFormat='€{0:0.00}'}"
                                                       FontSize="24" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#D4A437"
                                                       HorizontalOptions="End"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                
                                        <BoxView HeightRequest="1" 
                                                 BackgroundColor="#2a2a2a"
                                                 Margin="20,0"/>

                                    
                                        <HorizontalStackLayout Padding="20,12" Spacing="16">
                                            <Label Text="{Binding Duration, StringFormat='{0:h\\h\\ m\\m}'}"
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="·" 
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="Nonstop" 
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="·" 
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="{Binding FlightNumber}"
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                        </HorizontalStackLayout>

                                
                                        <Grid ColumnDefinitions="*,Auto" 
                                              Padding="20,0,20,16"
                                              ColumnSpacing="12">
                                            <Label Text="Vitoria Airlines"
                                                   FontSize="15" 
                                                   TextColor="#D4A437"
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold"/>

                                            <Button Grid.Column="1"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:FlightSearchResultsViewModel}}, Path=SelectOutboundFlightCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#D4A437"
                                                    TextColor="#0e0e0e"
                                                    CornerRadius="10"
                                                    FontAttributes="Bold"
                                                    HeightRequest="44"
                                                    WidthRequest="140">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Text" Value="Select"/>
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Button"
                                                                         Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="✓ Selected"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

             
                <Button Text="Book Flight"
                        IsVisible="{Binding CanBookOneWayFlight}"
                        Command="{Binding BookFlightsCommand}"
                        BackgroundColor="#4B0012"
                        TextColor="White"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="54"
                        FontSize="16">                   
                </Button>

            
                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasReturnFlights}">
                    <Label Text="RETURN FLIGHTS"
                           FontSize="12"
                           TextColor="#888888"
                           FontAttributes="Bold"
                           Margin="4,0,0,0"/>

                    <CollectionView ItemsSource="{Binding ReturnFlights}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:FlightSearchResult">
                                <Frame HasShadow="True"
                                       Padding="0"
                                       Margin="0,0,0,12"
                                       CornerRadius="16"
                                       BackgroundColor="#1a1a1a"
                                       BorderColor="Transparent">
                                    <Frame.Style>
                                        <Style TargetType="Frame">
                                            <Setter Property="BorderColor" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Frame"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="BorderColor" Value="#D4A437"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Frame.Style>

                                    <VerticalStackLayout Spacing="0">
                                 
                                        <Grid ColumnDefinitions="*,Auto,*,Auto" 
                                              Padding="20,16"
                                              RowSpacing="8">

                                  
                                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="{Binding DepartureUtc, StringFormat='{0:HH:mm}'}"
                                                       FontSize="24" 
                                                       FontAttributes="Bold" 
                                                       TextColor="White"/>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="#2a2a2a"
                                                            Padding="0"
                                                            WidthRequest="28"
                                                            HeightRequest="20"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding IsOriginCountryCodeVisible}">
                                                        <Image Source="{Binding OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                               Aspect="AspectFill"/>
                                                    </Border>
                                                    <Label Text="{Binding OriginAirportIATA}"
                                                           FontSize="20" 
                                                           FontAttributes="Bold" 
                                                           TextColor="White"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                    
                                            <Label Grid.Column="1" 
                                                   Text="→" 
                                                   FontSize="32" 
                                                   TextColor="#D4A437"
                                                   VerticalOptions="Center" 
                                                   HorizontalOptions="Center"
                                                   Margin="12,0"/>

                                       
                                            <VerticalStackLayout Grid.Column="2" Spacing="6">
                                                <Label Text="{Binding ArrivalUtc, StringFormat='{0:HH:mm}'}"
                                                       FontSize="24" 
                                                       FontAttributes="Bold" 
                                                       TextColor="White"/>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="#2a2a2a"
                                                            Padding="0"
                                                            WidthRequest="28"
                                                            HeightRequest="20"
                                                            VerticalOptions="Center"
                                                            IsVisible="{Binding IsDestinationCountryCodeVisible}">
                                                        <Image Source="{Binding DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}"
                                                               Aspect="AspectFill"/>
                                                    </Border>
                                                    <Label Text="{Binding DestinationAirportIATA}"
                                                           FontSize="20" 
                                                           FontAttributes="Bold" 
                                                           TextColor="White"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                      
                                            <VerticalStackLayout Grid.Column="3" 
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding EconomyClassPrice, StringFormat='€{0:0.00}'}"
                                                       FontSize="24" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#D4A437"
                                                       HorizontalOptions="End"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                  
                                        <BoxView HeightRequest="1" 
                                                 BackgroundColor="#2a2a2a"
                                                 Margin="20,0"/>

                                  
                                        <HorizontalStackLayout Padding="20,12" Spacing="16">
                                            <Label Text="{Binding Duration, StringFormat='{0:h\\h\\ m\\m}'}"
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="·" 
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="Nonstop" 
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="·" 
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                            <Label Text="{Binding FlightNumber}"
                                                   FontSize="13" 
                                                   TextColor="#888888"/>
                                        </HorizontalStackLayout>

                                    
                                        <Grid ColumnDefinitions="*,Auto" 
                                              Padding="20,0,20,16"
                                              ColumnSpacing="12">
                                            <Label Text="Vitoria Airlines"
                                                   FontSize="15" 
                                                   TextColor="#D4A437"
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold"/>

                                            <Button Grid.Column="1"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:FlightSearchResultsViewModel}}, Path=SelectReturnFlightCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#D4A437"
                                                    TextColor="#0e0e0e"
                                                    CornerRadius="10"
                                                    FontAttributes="Bold"
                                                    HeightRequest="44"
                                                    WidthRequest="140">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Text" Value="Select"/>
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Button"
                                                                         Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="✓ Selected"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

              
                <Button Text="Book Selected Flights"
                        IsVisible="{Binding CanBookRoundTripFlights}"
                        Command="{Binding BookFlightsCommand}"
                        BackgroundColor="#4B0012"
                        TextColor="White"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="54"
                        FontSize="16">                    
                </Button>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>