<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitoriaAirlinesMAUI.View.ResetPasswordPage"
             Title="{Binding Title}"
             BackgroundColor="#0e0e0e">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <VerticalStackLayout Spacing="8" Margin="0,20,0,10">                
                <Label Text="Create a new password for your account"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

           
            <Frame BackgroundColor="#1a1a1a" 
                   CornerRadius="16" 
                   Padding="20" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="20">

               
                    <VerticalStackLayout Spacing="8">
                        <Label Text="New Password"
                               FontSize="12"
                               TextColor="#888888"
                               Margin="4,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0"
                                    BackgroundColor="#2a2a2a"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16,0">
                                <Entry x:Name="NewPasswordEntry"
                                       Placeholder="Enter new password"
                                       Text="{Binding NewPassword}"
                                       IsPassword="{Binding IsNewPasswordHidden}"
                                       TextColor="White"
                                       PlaceholderColor="#666666"
                                       BackgroundColor="Transparent"
                                       HeightRequest="50"
                                       MaxLength="8"/>
                            </Border>
                            <ImageButton Grid.Column="1"
                                         Source="{Binding NewPasswordToggleIcon}"
                                         Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="20"
                                         HeightRequest="20"
                                         VerticalOptions="Center"
                                         Margin="12,0,0,0"/>
                        </Grid>
                    </VerticalStackLayout>

                  
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Confirm New Password"
                               FontSize="12"
                               TextColor="#888888"
                               Margin="4,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0"
                                    BackgroundColor="#2a2a2a"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16,0">
                                <Entry x:Name="ConfirmPasswordEntry"
                                       Placeholder="Confirm new password"
                                       Text="{Binding ConfirmPassword}"
                                       IsPassword="{Binding IsConfirmPasswordHidden}"
                                       TextColor="White"
                                       PlaceholderColor="#666666"
                                       BackgroundColor="Transparent"
                                       HeightRequest="50"
                                       MaxLength="8"/>
                            </Border>
                            <ImageButton Grid.Column="1"
                                         Source="{Binding ConfirmPasswordToggleIcon}"
                                         Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="20"
                                         HeightRequest="20"
                                         VerticalOptions="Center"
                                         Margin="12,0,0,0"/>
                        </Grid>
                    </VerticalStackLayout>

                   
                    <Border BackgroundColor="#2a2a2a"
                            StrokeShape="RoundRectangle 8"
                            Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password must contain:"
                                   FontSize="11"
                                   TextColor="#888888"
                                   FontAttributes="Bold"/>
                            <Label Text="At least 8 characters"
                                   FontSize="11"
                                   TextColor="#888888"/>                           
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Frame>

      
            <Border BackgroundColor="#DC3545"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    IsVisible="{Binding HasError}"
                    Margin="0,4">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="White"
                       FontSize="13"
                       HorizontalTextAlignment="Center"/>
            </Border>

         
            <Button Text="Reset Password"
                    Command="{Binding ResetPasswordCommand}"
                    BackgroundColor="#4B0012"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54"
                    FontSize="16"
                    IsEnabled="{Binding IsNotBusy}"
                    Margin="0,4,0,0">
            </Button>          


            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#D4A437"
                               HeightRequest="40"
                               WidthRequest="40"
                               HorizontalOptions="Center"
                               Margin="0,12"/>
           
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>