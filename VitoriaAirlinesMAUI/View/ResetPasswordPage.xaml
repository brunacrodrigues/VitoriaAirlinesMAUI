<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitoriaAirlinesMAUI.View.ResetPasswordPage"
             Title="{Binding Title}"
             BackgroundColor="#0e0e0e">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Reset Your Password"
                   FontSize="28"
                   HorizontalOptions="Center"
                   TextColor="#f0b400"
                   FontAttributes="Bold" />

            <!-- New Password with toggle -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="10,0"
                        StrokeThickness="0"
                        BackgroundColor="#1a1a1a"
                        StrokeShape="RoundRectangle 8">
                    <Entry x:Name="NewPasswordEntry"
                           Text="{Binding NewPassword}"
                           FontFamily="OutfitRegular"
                           IsPassword="{Binding IsNewPasswordHidden}"
                           Placeholder="New Password"
                           TextColor="White"
                           PlaceholderColor="Gray"
                           BackgroundColor="Transparent"
                           HeightRequest="50" />
                </Border>

                <ImageButton Grid.Column="0"
                             Source="{Binding NewPasswordToggleIcon}"
                             Command="{Binding ToggleNewPasswordVisibilityCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20"
                             HeightRequest="20"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Margin="0,0,10,0" />
            </Grid>

            <!-- Confirm New Password with toggle -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="10,0"
                        StrokeThickness="0"
                        BackgroundColor="#1a1a1a"
                        StrokeShape="RoundRectangle 8">
                    <Entry x:Name="ConfirmPasswordEntry"
                           Text="{Binding ConfirmPassword}"
                           FontFamily="OutfitRegular"
                           IsPassword="{Binding IsConfirmPasswordHidden}"
                           Placeholder="Confirm New Password"
                           TextColor="White"
                           PlaceholderColor="Gray"
                           BackgroundColor="Transparent"
                           HeightRequest="50" />
                </Border>

                <ImageButton Grid.Column="0"
                             Source="{Binding ConfirmPasswordToggleIcon}"
                             Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20"
                             HeightRequest="20"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Margin="0,0,10,0" />
            </Grid>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding HasError}" />

            <Button Text="Reset Password"
                    Command="{Binding ResetPasswordCommand}"
                    BackgroundColor="#4B0012"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
