<ContentPage
   x:Class="VitoriaAirlinesMAUI.View.PastFlightsPage"
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   xmlns:viewmodel="clr-namespace:VitoriaAirlinesMAUI.ViewModel"
   xmlns:model="clr-namespace:VitoriaAirlinesMAUI.Model"
   xmlns:converters="clr-namespace:VitoriaAirlinesMAUI.Converters"
   x:DataType="viewmodel:FlightsHistoryViewModel"
   BackgroundColor="#0e0e0e"
   Title="{Binding Title}"
   Loaded="ContentPage_Loaded">

    <ContentPage.Resources>
        <converters:CountryCodeToFlagUrlConverter x:Key="CountryCodeToFlagUrlConverter" />

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
        </Style>

        <Style TargetType="Frame">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HasShadow" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="12,8"/>
            <Setter Property="BackgroundColor" Value="#1a1a1a"/>
            <Setter Property="BorderColor" Value="Transparent"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="20">

       
        <VerticalStackLayout Spacing="4" Margin="0,10,0,10">
            <Label Text="Here you can view the flights you've already taken." 
                   FontSize="14"
                   TextColor="#888888"/>
        </VerticalStackLayout>

       
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     RefreshColor="#D4A437">
            <CollectionView
                ItemsSource="{Binding Tickets}"
                SelectionMode="None"
                Margin="0,8,0,0">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="15" 
                                       VerticalOptions="Center"
                                       Padding="40">
                        <Image Source="myflights_icon.png" 
       WidthRequest="125" 
       HeightRequest="50" 
       HorizontalOptions="Center"
       Margin="0,0,10,5"/>
                        <Label Text="No past flights found"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="Your completed flights will appear here"
                               FontSize="14"
                               TextColor="#888888"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Ticket">
                        <Frame>
                            <VerticalStackLayout Spacing="0">

                          
                                <Grid BackgroundColor="#4B0012" 
                                      Padding="18,14"
                                      ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding FlightNumber}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                    <Border Grid.Column="1"
                                            BackgroundColor="#66BB6A"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="10,6">
                                        <Label Text="{Binding Status}"
                                               TextColor="#0e0e0e"
                                               FontSize="12"
                                               FontAttributes="Bold"/>
                                    </Border>
                                </Grid>

                              
                                <VerticalStackLayout BackgroundColor="#1a1a1a" 
                                                   Padding="18,16"
                                                   Spacing="12">

                                 
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#2a2a2a"
                                                Padding="2"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                VerticalOptions="Center">
                                            <Image Aspect="AspectFill"
                                                   Source="{Binding OriginCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="{Binding OriginAirport}"
                                               FontSize="15"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                 
                                    <Label Text="↓" 
                                           FontSize="20"
                                           TextColor="#D4A437"
                                           Margin="14,0,0,0"/>

                                
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#2a2a2a"
                                                Padding="2"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                VerticalOptions="Center">
                                            <Image Aspect="AspectFill"
                                                   Source="{Binding DestinationCountryCode, Converter={StaticResource CountryCodeToFlagUrlConverter}}" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="{Binding DestinationAirport}"
                                               FontSize="15"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                
                                    <BoxView HeightRequest="1"
                                             BackgroundColor="#2a2a2a"
                                             Margin="0,8,0,8"/>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="Departure"
                                                   FontSize="11"
                                                   TextColor="#888888"/>
                                            <Label Text="{Binding DepartureUtc, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="Arrival"
                                                   FontSize="11"
                                                   TextColor="#888888"
                                                   HorizontalOptions="End"/>
                                            <Label Text="{Binding ArrivalUtc, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="End"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                   
                                    <BoxView HeightRequest="1"
                                             BackgroundColor="#2a2a2a"
                                             Margin="0,8,0,8"/>

                                  
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="Seat: "
                                                   FontSize="13"
                                                   TextColor="#888888"/>
                                            <Label Text="{Binding Seat}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"/>
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding PricePaid, StringFormat='€{0:0.00}'}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#D4A437"
                                               HorizontalOptions="End"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>