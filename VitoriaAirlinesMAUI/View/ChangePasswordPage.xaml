<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitoriaAirlinesMAUI.View.ChangePasswordPage"
             BackgroundColor="#0e0e0e"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Change Your Password"
                   FontSize="24"
                   FontFamily="OutfitSemiBold"
                   TextColor="#D4A437"
                   HorizontalOptions="Center" />

            <!-- Old Password -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BackgroundColor="#2a2a2a"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,0">
                    <Entry Placeholder="Current Password"
                           Text="{Binding CurrentPassword}"
                           IsPassword="{Binding IsCurrentPasswordHidden}"
                           FontFamily="OutfitRegular"
                           TextColor="White"
                           PlaceholderColor="#888"
                           BackgroundColor="Transparent"
                           HeightRequest="50"/>
                </Border>

                <ImageButton Grid.Column="1"
                             Source="{Binding CurrentPasswordToggleIcon}"
                             Command="{Binding ToggleCurrentPasswordVisibilityCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20"
                             HeightRequest="20"
                             VerticalOptions="Center"
                             Margin="10,0"/>
            </Grid>

            <!-- New Password -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BackgroundColor="#2a2a2a"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,0">
                    <Entry Placeholder="New Password"
                           Text="{Binding NewPassword}"
                           IsPassword="{Binding IsNewPasswordHidden}"
                           FontFamily="OutfitRegular"
                           TextColor="White"
                           PlaceholderColor="#888"
                           BackgroundColor="Transparent"
                           HeightRequest="50"/>
                </Border>

                <ImageButton Grid.Column="1"
                             Source="{Binding NewPasswordToggleIcon}"
                             Command="{Binding ToggleNewPasswordVisibilityCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20"
                             HeightRequest="20"
                             VerticalOptions="Center"
                             Margin="10,0"/>
            </Grid>

            <!-- Confirm Password -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BackgroundColor="#2a2a2a"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,0">
                    <Entry Placeholder="Confirm Password"
                           Text="{Binding ConfirmPassword}"
                           IsPassword="{Binding IsConfirmPasswordHidden}"
                           FontFamily="OutfitRegular"
                           TextColor="White"
                           PlaceholderColor="#888"
                           BackgroundColor="Transparent"
                           HeightRequest="50"/>
                </Border>

                <ImageButton Grid.Column="1"
                             Source="{Binding ConfirmPasswordToggleIcon}"
                             Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20"
                             HeightRequest="20"
                             VerticalOptions="Center"
                             Margin="10,0"/>
            </Grid>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#f8f8f8"
                   BackgroundColor="#850d1c"
                   Padding="10"
                   FontSize="12"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="Center"/>

            <!-- Save Button -->
            <Button Text="Update Password"
                    Command="{Binding SubmitCommand}"
                    BackgroundColor="#4B0012"
                    FontFamily="OutfitRegular"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    IsEnabled="{Binding IsNotBusy}" />

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="White"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
