<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitoriaAirlinesMAUI.View.ForgotPasswordPage"
             BackgroundColor="#0e0e0e"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <VerticalStackLayout Spacing="8" Margin="0,40,0,10">
                <Label Text="Enter your email to receive a recovery link"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="20,0"/>
            </VerticalStackLayout>

        
            <Frame BackgroundColor="#1a1a1a" 
                   CornerRadius="16" 
                   Padding="20" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Email Address"
                           FontSize="12"
                           TextColor="#888888"
                           Margin="4,0"/>
                    <Border BackgroundColor="#2a2a2a"
                            StrokeShape="RoundRectangle 10"
                            Padding="16,0">
                        <Entry Placeholder="Enter your email address"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               TextColor="White"
                               PlaceholderColor="#666666"
                               BackgroundColor="Transparent"
                               HeightRequest="50"/>
                    </Border>
                </VerticalStackLayout>
            </Frame>

         
            <Border BackgroundColor="#DC3545"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    IsVisible="{Binding HasError}"
                    Margin="0,4">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="White"
                       FontSize="13"
                       HorizontalTextAlignment="Center"/>
            </Border>

   
            <Button Text="Send Recovery Email"
                    Command="{Binding SendRecoveryEmailCommand}"
                    BackgroundColor="#4B0012"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54"
                    FontSize="16"
                    IsEnabled="{Binding IsNotBusy}"
                    Margin="0,8,0,0">               
            </Button>

            <Button Text="Open Yopmail"
          Command="{Binding OpenYopmailCommand}"
          BackgroundColor="#333333"
          TextColor="White"
          CornerRadius="12"
          HeightRequest="54"
          FontSize="14"
          Margin="0,16,0,0">
            </Button>


            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#D4A437"
                               HeightRequest="40"
                               WidthRequest="40"
                               HorizontalOptions="Center"
                               Margin="0,12"/>

       
            <Border BackgroundColor="#1a1a1a"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Margin="0,20,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="What happens next?"
                           FontSize="13"
                           TextColor="White"
                           FontAttributes="Bold"/>
                    <Label Text="We'll send you an email with instructions to reset your password. Please check your inbox and spam folder."
                           FontSize="12"
                           TextColor="#888888"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

           
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>